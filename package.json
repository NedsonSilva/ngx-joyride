{
    "name": "workspace",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve --port 4500",
        "build": "ng build demo --configuration production",
        "test": "ng test",
        "test:unit": "ng test ngx-joyride --browsers=ChromeHeadlessNoSandbox --watch=false",
        "test:unit:ci": "CHROME_BIN=/usr/bin/google-chrome ng test ngx-joyride --browsers=ChromeHeadlessNoSandbox --watch=false --code-coverage=true",
        "test:cypress": "run-p -r \"start\" \"cy:run\"",
        "cy:run": "wait-on http-get://localhost:4500/ && cypress run --config-file cypress.config.js",
        "lint": "ng lint ngx-joyride && ng lint demo"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^17.3.12",
        "@angular/common": "^17.3.12",
        "@angular/compiler": "^17.3.12",
        "@angular/core": "^17.3.12",
        "@angular/forms": "^17.3.12",
        "@angular/platform-browser": "^17.3.12",
        "@angular/platform-browser-dynamic": "^17.3.12",
        "@angular/router": "^17.3.12",
        "@ngx-translate/core": "^14.0.0",
        "rxjs": "^7.8.1",
        "tslib": "^2.2.0",
        "zone.js": "~0.14.8"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^17.3.17",
        "@angular-devkit/core": "^17.3.17",
        "@angular-devkit/schematics": "^17.3.17",
        "@angular/cli": "^17.3.17",
        "@angular/compiler-cli": "^17.3.12",
        "@angular/language-service": "^17.3.12",
        "@angular-eslint/builder": "^17.5.3",
        "@angular-eslint/eslint-plugin": "^17.5.3",
        "@angular-eslint/eslint-plugin-template": "^17.5.3",
        "@angular-eslint/template-parser": "^17.5.3",
        "@types/jasmine": "~5.1.4",
        "@types/jasminewd2": "~2.0.3",
        "@types/node": "~18.19.33",
        "cypress": "^13.17.0",
        "@typescript-eslint/eslint-plugin": "^7.7.1",
        "@typescript-eslint/parser": "^7.7.1",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^10.1.2",
        "jasmine-core": "~5.1.2",
        "jasmine-spec-reporter": "~6.0.0",
        "karma": "~6.3.2",
        "karma-chrome-launcher": "~3.1.0",
        "karma-coverage": "^2.1.0",
        "karma-jasmine": "~4.0.0",
        "karma-jasmine-html-reporter": "^1.7.0",
        "ng-packagr": "^17.3.0",
        "npm-run-all": "^4.1.5",
        "ts-node": "10.9.2",
        "typescript": "~5.4.5",
        "wait-on": "^6.0.0"
    }
}
